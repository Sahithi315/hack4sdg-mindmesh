# Copy this file to .env and fill it in. NEVER commit .env to git.
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///cardwapas.db

# Public URL of the site (used inside QR codes). Use your deployed https URL.
# For local testing with a phone, use your laptop's LAN IP, e.g. http://192.168.1.5:5000
BASE_URL=http://127.0.0.1:5000

# Email (Gmail: create an "App Password" in your Google account settings).
# Leave MAIL_USERNAME empty to just print emails to the console while developing.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER=
