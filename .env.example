# Copy this file to .env and fill it in. NEVER commit .env to git.
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///cardwapas.db

# Public URL of the site — used inside QR codes and links.
# For local development: leave as http://127.0.0.1:5000
# For production: use your deployed HTTPS URL, e.g. https://cardwapas.yourdomain.com
# If testing on a phone over your LAN: use http://192.168.x.x:5000
BASE_URL=http://127.0.0.1:5000

# Email (Gmail: create an "App Password" in your Google account settings).
# Leave MAIL_USERNAME empty to print notification emails to the console during development.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER=
